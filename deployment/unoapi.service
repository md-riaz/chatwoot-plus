[Unit]
Description=UnoAPI service
Requires=network.target
PartOf=chatwoot.target

[Service]
Type=simple
User=chatwoot
WorkingDirectory=/home/chatwoot/unoapi
EnvironmentFile=/home/chatwoot/chatwoot/.env
Environment="PORT=9876"
ExecStart=/bin/bash -lc 'UNOAPI_AUTH_TOKEN="$UNOAPI_API_KEY" pnpm start'
Restart=always
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
StandardInput=null
SyslogIdentifier=%p
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
